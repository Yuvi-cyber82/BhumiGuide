# Copy this file to backend/.env and fill in the values you need.
# backend/.env is gitignored — NEVER put a real key in this file.
#
# Everything here is optional except JWT_SECRET. With an empty .env the
# server still runs: it starts a temporary in-memory MongoDB, the AI
# Assistant uses its built-in rule engine, and email OTPs are printed to
# the terminal instead of being sent.

# ── Database ──────────────────────────────────────────────────────────
# Leave blank to run a temporary in-memory MongoDB (data is lost on
# restart). For a persistent database, paste an Atlas connection string:
# mongodb+srv://<user>:<password>@<cluster>/bhumiguide
MONGO_URI=

# Signs the login tokens. Use a long random string of your own.
JWT_SECRET=change-this-to-a-long-random-string

PORT=4000

# ── AI Assistant (optional) ───────────────────────────────────────────
# Without a key the assistant answers from its own rule engine, in
# whichever of the nine languages the user has selected.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Leave blank to let the app pick the best text model the key can use.
# Set one to pin it, e.g. llama-3.3-70b-versatile
GROQ_MODEL=

# Alternative provider — used only if GROQ_API_KEY is empty.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── Sign in with Google (optional) ────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application). The SAME id also goes in frontend/.env as
# VITE_GOOGLE_CLIENT_ID. A client ID is public by design; there is no
# client secret in this flow.
GOOGLE_CLIENT_ID=

# ── Email OTP for signup verification (optional) ──────────────────────
# Gmail address + a Google App Password (not your account password):
# https://myaccount.google.com/apppasswords
# Leave blank and the OTP is printed to the backend terminal instead.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Fallback email provider, used only if GMAIL_USER is empty.
# https://resend.com/api-keys
RESEND_API_KEY=
