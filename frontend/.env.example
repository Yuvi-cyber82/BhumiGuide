# Copy to frontend/.env only if you need to change a default.
# frontend/.env is gitignored.

# Where the backend is. Leave commented out for the default.
# VITE_API_URL=http://localhost:4000/api

# Sign in with Google — the same OAuth client ID as backend/.env.
# A client ID is public by design (the browser sends it to Google), but
# keep it out of the repo anyway so each person uses their own.
VITE_GOOGLE_CLIENT_ID=
